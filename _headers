# Cloudflare Pages response headers (copied to dist/ by build.js).
#
# Clawspire (round 18): build.js stamps every script URL with ?v=<content hash>
# (the script tags in clawspire/*.html and the lazy Dutch tables in js/i18n.js),
# so a changed file always gets a new URL and the scripts can be cached for a
# year. index.html itself keeps the default (revalidated on every visit), which
# is what picks up the new hashes after a deploy.
/clawspire/js/*
  Cache-Control: public, max-age=31536000, immutable
