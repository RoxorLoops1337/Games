# Cloudflare Pages response headers (copied to dist/ by build.js).
#
# Clawspire (round 18): build.js stamps every script URL with ?v=<content hash>
# (the script tags in clawspire/*.html and the lazy Dutch tables in js/i18n.js),
# so a changed file always gets a new URL and the scripts can be cached for a
# year. index.html itself keeps the default (revalidated on every visit), which
# is what picks up the new hashes after a deploy.
/clawspire/js/*
  Cache-Control: public, max-age=31536000, immutable

# Awesome Farm: Vite names every file in play/assets/ by its content hash; play/index.html stays revalidated.
/awesome_farm/play/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Graftwork: HTML, JS and the two manifests stay revalidated (the defaults), so a deploy is picked up at once. The painted art (assets/ward,
# assets/ward_kit, assets/title) has plain names, not hashes, so it is NOT immutable: fresh for 10 minutes (instant repeat visits and screen
# changes), then served stale for up to a day while the browser revalidates in the background. Art is regenerated by hand, rarely; a manifest
# that changed sizes or anchors can sit next to an older cached image for at most those 10 minutes after a deploy.
/graftwork/assets/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
